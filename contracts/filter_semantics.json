        ],
        "ownerKinds": [
          "llc"
        ],
        "scoreMin": 0.7,
        "assessedValue": [
          1000,
          50000
        ]
      },
      "where": "list_has_any(states, ['AR', 'MT']) AND distress_tier IN ('distressed') AND owner_kind IN ('llc') AND score >= 0.7 AND total_assessed_value BETWEEN 1000 AND 50000",
      "expected_ids": [
        "o01",
        "o08",
        "o11"
      ]
    },
