  "cases": [
    {
      "name": "empty model matches every owner",
      "filter": {},
      "where": "",
      "expected_ids": [
        "o01",
        "o02",
        "o03",
        "o04",
        "o05",
        "o06",
        "o07",
        "o08",
        "o09",
        "o10",
        "o11",
        "o12"
      ]
    },
    {
      "name": "single state (list overlap)",
      "filter": {
        "states": [
          "AR"
        ]
      },
      "where": "list_has_any(states, ['AR'])",
      "expected_ids": [
        "o01",
        "o05",
        "o08",
        "o11"
      ]
    },
    {
      "name": "multi state is OR (list overlap)",
      "filter": {
        "states": [
          "MT",
          "FL"
