# Caddy edge config for the hosted Phase-1 app (PRD #96, ADR-064).
#
# One Caddy serves three things inside the single Fly machine:
#   1. /api/*               → reverse-proxied to uvicorn (the FastAPI backend)
#   2. /data/processed/*    → the served composite on the volume, with Range/206
#                             + gzip, marked private/no-store (it is parcel-owner
#                             PII and must never sit in a cache)
#   3. everything else      → the built SPA (app/dist) with history fallback
#
# TLS terminates at the Cloudflare and Fly edges, so Caddy speaks plain HTTP on
# an internal port (auto_https off). Paths/ports/upstream are env-driven with
# production defaults, so the integration test boots this exact file against
# fixtures (tests/test_caddy_serving.py).
{
	admin off
	auto_https off
}

:{$CADDY_PORT:8080} {
	encode gzip

	# HSTS on every response (TLS is enforced at the Cloudflare + Fly edges).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	# API → uvicorn (the FastAPI backend, same machine, internal port).
	handle /api/* {
		reverse_proxy {$BACKEND_UPSTREAM:127.0.0.1:8000}
	}

	# Served composite (PII): byte-range friendly, never cached anywhere, and
	# gated behind the session (PRD #130).
	handle /data/processed/* {
		# Before serving a single byte, ask the backend whether this request is
		# authenticated (PRD #130): the session cookie rides along on MapLibre
		# tile fetches, PMTiles range requests, and DuckDB-WASM parquet reads,
		# so the gate is invisible to a signed-in browser. On a non-2xx the
		# backend's 401 is returned and the file is never touched.
		forward_auth {$BACKEND_UPSTREAM:127.0.0.1:8000} {
			uri /api/auth/check
		}
		# Volume is mounted at /data and the served subtree is /data/processed,
		# so the URL path /data/processed/X maps 1:1 onto the filesystem when the
		# root is "/". The test points DATA_WEB_ROOT at its fixture volume's parent.
		root * {$DATA_WEB_ROOT:/}
		# Parcel-owner PII: keep it out of every cache (browser + Cloudflare;
		# a /data/* cache-bypass rule at the edge backs this up).
		header Cache-Control "private, no-store"
		file_server
	}

	# Anything else under /data is volume-internal — the SQLite DB and users.txt
	# live at the volume root, outside the web-served subtree. Refuse them
	# explicitly so they can never leak through the static file server, and so a
	# miss doesn't fall through to the SPA's 200.
	handle /data/* {
		respond 404
	}

	# The data-audit browser (internal QA docs) lives at /audit/, gated by the
	# SAME session as /data/processed/* — the audit exposes internal data
	# semantics, so it is never public. Both blocks ask the backend's
	# forward-auth seam before serving a byte; on a non-2xx the 401 is returned.
	#
	# The artifacts it live-fetches (index.json + the dossier .md) are baked into
	# the image at /srv/audit-data and served at /audit/data/*. A re-run that
	# rewrites docs/research/data-audit/ ships on the next `deploy.sh code`.
	# Listed before the SPA block so it wins for the /audit/data/* prefix.
	handle_path /audit/data/* {
		forward_auth {$BACKEND_UPSTREAM:127.0.0.1:8000} {
			uri /api/auth/check
		}
		root * {$AUDIT_DATA_ROOT:/srv/audit-data}
		# Internal data semantics — keep out of every cache, like /data/processed.
		header Cache-Control "private, no-store"
		file_server
	}

	# The audit SPA bundle (base-pathed at /audit/). handle_path strips /audit so
	# the on-disk root is the bundle; try_files gives the hash-router its history
	# fallback. Content-hashed /assets/* (post-strip) are cached immutable.
	handle_path /audit/* {
		forward_auth {$BACKEND_UPSTREAM:127.0.0.1:8000} {
			uri /api/auth/check
		}
		root * {$AUDIT_SITE_ROOT:/srv/audit-dist}
		@audit_assets path /assets/*
		header @audit_assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	# Everything else is the SPA: serve static assets, fall back to index.html
	# so client-side routes (deep links / refreshes) resolve.
	handle {
		root * {$SITE_ROOT:/srv/dist}
		# Vite emits content-hashed, immutable filenames under /assets/* — cache
		# them hard so a repeat visit never revalidates the MapLibre/DuckDB
		# chunks (PERF-019). Scoped to /assets/* only: index.html (and anything
		# else at the root) stays revalidated, so a new deploy is picked up at
		# once. Non-PII, hashed bundle assets — distinct from /data/processed/*,
		# which stays private/no-store above.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
