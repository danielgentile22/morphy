# Copy to .env (git-ignored). Production values are Fly secrets, set by name
# with `fly secrets set`; never commit real values.

# Build-time basemap key, read by deploy.sh and passed as a Docker build arg.
VITE_MAPTILER_KEY=

# Backend auth.
AUTH_JWT_SECRET=
AUTH_DEV_MODE=

# Public read-only demo (ADR-077). Off unless "1"/"true". When on, the backend
# refuses to boot unless DEMO_USERNAME names a read_only credential
# (create it with `cd backend && python -m app.demo_seed`).
DEMO_MODE=
DEMO_USERNAME=demo

# Local only: the data TUI's "diagnose" action (scripts/diagnose.py).
ANTHROPIC_API_KEY=

# Litestream replication of the SQLite database to R2.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
