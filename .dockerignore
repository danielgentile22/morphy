# Keep the Docker build context tiny and secret-free (PRD #96).
# The ~15 GB data tree is synced to the volume separately (deploy.sh), never
# baked into the image; the real credentials file lives on the volume, never
# in the image.
.git
.venv
data
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache

# Frontend build inputs we don't need in the context (the image rebuilds dist).
**/node_modules
app/dist
app/test-results
app/playwright-report
audit-site/dist
audit-site/.shots

# Never bake credentials or backend tests into the image.
backend/users.txt
backend/tests

# Docs / dev-only trees — except the data-audit artifacts, which the audit
# browser image bakes in (served at /audit/data/*, behind the session gate).
# The four-line dance keeps `docs/` walkable so the negation can reach the
# nested subtree (a flat `docs` exclude can't be re-included).
docs/*
!docs/research
docs/research/*
!docs/research/data-audit
app_puller
tests
