# ─── Data (PII; never commit) ────────────────────────────────────────
# All raw + processed data is git-ignored. data/ may contain parcel-owner
# names + mailing addresses (PII when combined). See docs/SECURITY.md.
# `data` is a real dir or a symlink to an external drive.
data
data.local-bak/
!data/.gitkeep

# Local environment overrides (secrets). Only the empty templates are tracked.
.env*
*.env
!.env.example

# ─── Backend credentials (password hashes; never commit) ─────────────
# A legacy users file, the input to `python -m app.users import-file`. Only
# backend/users.txt.example (fake entries) is committed. Guarded by backend/tests/test_commit_guard.py.
backend/users.txt

# ─── Python ──────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
build/
dist/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# .python-version is committed: uv pins the interpreter from it.

# ─── Node (map app) ────────────────────────────────────────────────
node_modules/
.npm/
.vite/
.svelte-kit/

# ─── OS / editor cruft ───────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.Rhistory
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Local Claude Code state ─────────────────────────────────────────
.claude/projects/
.claude/cache/
.claude/settings.local.json
.claude/*.lock

# ─── Backups + temp ──────────────────────────────────────────────────
*.bak
*.tmp
*.log
!data/fetch.log         # actually we *do* ignore the whole data/ above; the
                        # negation is intentional for clarity only
backups/

# ─── Throwaway UI verification artifacts (slice screenshots, MCP logs) ─
screenshots/
.playwright-mcp/
# Local code-review-graph index
.code-review-graph/
# Local MCP server wiring (machine-specific absolute paths — not portable)
.mcp.json
