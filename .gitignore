# ─── Data (PII; never commit) ────────────────────────────────────────
# All raw + processed data is git-ignored. data/ may contain parcel-owner
# names + mailing addresses (PII when combined). See docs/SECURITY.md.
data/
!data/.gitkeep

# Local environment overrides
# NB: `*.env` only matches names ENDING in .env; `.env.*` catches .env.share etc.
.env
.env.local
*.env
.env.*

# ─── Backend credentials (password hashes; never commit) ─────────────
# The real users file. Only backend/users.txt.example (fake entries) is
# committed. Guarded by backend/tests/test_commit_guard.py.
backend/users.txt

# ─── Python ──────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
build/
dist/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# .python-version is COMMITTED (uv pins the interpreter from it — PRD #132)

# ─── Node (for future map app v2) ────────────────────────────────────
node_modules/
.npm/
.vite/
.svelte-kit/

# ─── OS / editor cruft ───────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.Rhistory
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Local Claude Code state ─────────────────────────────────────────
.claude/projects/
.claude/cache/
.claude/settings.local.json
.claude/*.lock
# NOTE: .claude/plans/ may contain working plan docs — uncomment to ignore.

# ─── Backups + temp ──────────────────────────────────────────────────
*.bak
*.tmp
*.log
!data/fetch.log         # actually we *do* ignore the whole data/ above; the
                        # negation is intentional for clarity only
backups/

# ─── User-config persisted by puller ─────────────────────────────────
# (Section 3 adds ~/.config/pilot/puller_state.json — outside repo, ignored
# anyway, but documented here)

# ─── Data Catalog freshness snapshot (M8 exporter; PRD #178) ─────────
# Generated at deploy time from data/manifest.json (which is git-ignored, so
# this snapshot must be too) and baked into the audit image — never committed,
# so the catalog's "What needs updating" view always reflects the live puller.
docs/research/data-audit/freshness.json

# ─── Throwaway UI verification artifacts (slice screenshots, MCP logs) ─
screenshots/
.playwright-mcp/
# Added by code-review-graph
.code-review-graph/
# Local MCP server wiring (machine-specific absolute paths — not portable)
.mcp.json
