{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphy/schemas/index.schema.json",
  "title": "Composite global state index",
  "description": "The contract between the Python preprocess pipeline (app_assets.py build_index) and the TypeScript map app (catalog.ts parseCompositeIndex). This file is the single source of truth — both sides must conform.",

  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "states"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Pinned to 1 in code (INDEX_SCHEMA_VERSION in app_assets.py). Bumped on incompatible changes."
    },
    "generated_at": {
      "type": "string",
      "minLength": 1,
      "description": "ISO 8601 timestamp."
    },
    "states": {
      "type": "array",
      "items": { "$ref": "#/$defs/StateEntry" }
    }
  },

  "$defs": {
    "StateEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fips", "abbr", "name", "bbox", "counts"],
      "properties": {
        "fips": { "type": "string", "minLength": 2, "maxLength": 2 },
        "abbr": { "type": "string", "minLength": 2, "maxLength": 2 },
        "name": { "type": "string", "minLength": 1 },
        "bbox": {
          "type": "array",
          "description": "[minLng, minLat, maxLng, maxLat] in EPSG:4326.",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "counts": {
          "type": "object",
          "description": "canonical_type -> row count for the composed state.",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
